# exiftool user-defined XMP namespace for pipeline provenance (spec section 6).
# Loaded via `exiftool -config` / pyexiftool config_file for all reads/writes
# of the XMP-ArchivePipe group.

%Image::ExifTool::UserDefined::ArchivePipe = (
    GROUPS => { 0 => 'XMP', 1 => 'XMP-ArchivePipe', 2 => 'Image' },
    NAMESPACE => { 'ArchivePipe' => 'http://binarybottle.com/ns/archivepipe/1.0/' },
    WRITABLE => 'string',
    DateSource      => { },
    DatePrecision   => { },
    OriginalDate    => { },
    MergedFrom      => { List => 'Bag' },
    SourcePath      => { },
    PipelineVersion => { },
    SequenceHint    => { },
);

%Image::ExifTool::UserDefined = (
    'Image::ExifTool::XMP::Main' => {
        ArchivePipe => {
            SubDirectory => { TagTable => 'Image::ExifTool::UserDefined::ArchivePipe' },
        },
    },
);

1;  # end
